# The environment of .github/workflows/ci.yml for tools/ci-local.sh: Python 3.12 as CI sets it up, plus what
# GitHub's ubuntu-latest runner brings or the jobs install with apt-get (Qt's runtime libraries, libevdev for
# cec's key names, shellcheck, fakeroot, git, nasm and the libva headers, Rust with clippy). Built once; rebuilt when this file changes. The jobs
# run as an ordinary user, as on GitHub (the installers refuse root), so Rust sits in /opt for everyone.
FROM docker.io/library/python:3.12-bookworm
RUN apt-get update -q \
 && apt-get install -y -q --no-install-recommends libegl1 libgl1 libxkbcommon0 libdbus-1-3 libfontconfig1 \
      libglib2.0-0 libpulse0 libgssapi-krb5-2 libevdev2 shellcheck fakeroot git rsync nasm libva-dev pkg-config \
 && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y -q --profile minimal --component clippy --no-modify-path \
 && chmod -R a+rX /opt/rustup /opt/cargo
ENV PATH=/opt/cargo/bin:$PATH
RUN pip install -q --no-cache-dir --root-user-action=ignore "pyyaml>=6,<7" \
 && git config --system --add safe.directory '*'
