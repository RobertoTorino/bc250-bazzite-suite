#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Starts RetroArch (the Flatpak) with the SwanStation core that SwanStation Manager installed:
#
#   bc250-swanstation-run --fullscreen /path/to/game.cue   a game full screen (Game Mode)
#   bc250-swanstation-run /path/to/game.cue                a game as RetroArch is set up
#   bc250-swanstation-run                                  RetroArch's own window, for its settings
#
# The Steam shortcuts run this, not RetroArch, so they keep working when the app brings another core.
set -euo pipefail

CORE="${XDG_DATA_HOME:-$HOME/.local/share}/bc250-swanstation-manager/emulator/core/swanstation_libretro.so"
APP_ID="org.libretro.RetroArch"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '3,8p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi
command -v flatpak >/dev/null 2>&1 || {
    echo "flatpak is not installed: RetroArch comes as a Flatpak." >&2
    exit 1
}
flatpak info "$APP_ID" >/dev/null 2>&1 || {
    echo "RetroArch is not installed: open SwanStation Manager and press Install." >&2
    exit 1
}
# RetroArch's own window: no core, its menu.
if [ $# -eq 0 ]; then
    exec flatpak run "$APP_ID"
fi
[ -f "$CORE" ] || {
    echo "The SwanStation core is not installed: open SwanStation Manager and press Install." >&2
    exit 1
}
# On a Wayland desktop RetroArch may open its window through Wayland, and Steam sees only X11 windows: no overlay
# (Shift+Tab, the PS button) over a game it started. A game Steam starts there gets no Wayland socket in the
# Flatpak, so RetroArch falls back to XWayland, as the other emulator managers do. Game Mode is X11 already.
OPTIONS=()
if [ -n "${SteamGameId:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${DISPLAY:-}" ]; then
    OPTIONS+=(--nosocket=wayland)
fi
exec flatpak run ${OPTIONS[@]+"${OPTIONS[@]}"} "$APP_ID" -L "$CORE" "$@"
