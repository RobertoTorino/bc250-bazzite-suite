#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Starts the mGBA that mGBA Manager installed, with the arguments given:
#
#   bc250-mgba-run -f /path/to/game.gba   a game full screen (Game Mode)
#   bc250-mgba-run /path/to/game.gba      a game in a window
#   bc250-mgba-run                        mGBA's own window, for its settings and controllers
#
# The Steam shortcuts run this, not the AppImage, so they keep working when the app brings another mGBA.
set -euo pipefail

APPIMAGE="${XDG_DATA_HOME:-$HOME/.local/share}/bc250-mgba-manager/emulator/current/mgba.AppImage"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi
[ -x "$APPIMAGE" ] || {
    echo "mGBA is not installed: open mGBA Manager and press Install." >&2
    exit 1
}
# mGBA's AppImage mounts itself with FUSE 2 (libfuse.so.2, part of Bazzite), as shadPS4's does; without it, it
# unpacks itself to a temporary folder on every start instead.
if command -v ldconfig >/dev/null 2>&1 && ! ldconfig -p 2>/dev/null | grep -q 'libfuse\.so\.2'; then
    export APPIMAGE_EXTRACT_AND_RUN=1
fi
# A game started by Steam gets SDL told to ignore the controllers Steam handles, and Steam's virtual controller
# (28DE:11FF) in their place: on the desktop it follows Steam's Desktop Configuration (mouse and keys). As PCSX2
# Manager does: while a real controller is connected, mGBA's SDL input reads it and leaves Steam's virtual one out.
# Without a real one (a Steam Deck's own controls) Steam's choice stands.
INPUT_DEVICES="${BC250_INPUT_DEVICES:-/proc/bus/input/devices}"      # another file only in the tests
real_controller() {
    # A joystick (js handler) that is not one of Steam's (vendor 28DE).
    awk '/^I:/ { vendor = ""; for (i = 1; i <= NF; i++) if ($i ~ /^Vendor=/) vendor = tolower(substr($i, 8)) }
         /^H:/ && / js[0-9]/ && vendor != "28de" { found = 1 }
         END { exit !found }' "$INPUT_DEVICES" 2>/dev/null
}
if [ -n "${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}${SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT:-}" ] && real_controller; then
    unset SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT
    export SDL_GAMECONTROLLER_IGNORE_DEVICES=0x28DE/0x11FF
fi
# On a Wayland desktop mGBA (a Qt program) opens its windows through Wayland when it can, and Steam on the desktop
# only sees windows that go through X11: no overlay (Shift+Tab, the Steam button) over a game it started. A game
# Steam starts there opens its windows through XWayland, as PCSX2 Manager does for PCSX2. Game Mode is X11 already.
if [ -n "${SteamGameId:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${DISPLAY:-}" ] &&
   [ -z "${QT_QPA_PLATFORM:-}" ]; then
    export QT_QPA_PLATFORM=xcb
fi
exec "$APPIMAGE" "$@"
